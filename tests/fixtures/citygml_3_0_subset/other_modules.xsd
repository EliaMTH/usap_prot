<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test fixture: the handful of non-building CityGML 3.0 classes the suite
  touches. Kept in one file only because each contributes a class or two;
  the real distribution has a schema per module.

  Note TrafficArea and TINRelief are space *boundaries*, and Road is an
  unoccupied space — the abstract layer the deleted registry collapsed.
-->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:core="http://www.opengis.net/citygml/3.0"
        xmlns:tran="http://www.opengis.net/citygml/transportation/3.0"
        elementFormDefault="qualified"
        targetNamespace="http://www.opengis.net/citygml/transportation/3.0"
        version="3.0.0">

  <import namespace="http://www.opengis.net/citygml/3.0" schemaLocation="core.xsd"/>

  <element abstract="true" name="AbstractTransportationSpace" substitutionGroup="core:AbstractUnoccupiedSpace" type="anyType"/>
  <element name="Road" substitutionGroup="tran:AbstractTransportationSpace" type="anyType"/>
  <element name="Track" substitutionGroup="tran:AbstractTransportationSpace" type="anyType"/>
  <element name="Section" substitutionGroup="tran:AbstractTransportationSpace" type="anyType"/>
  <element name="Intersection" substitutionGroup="tran:AbstractTransportationSpace" type="anyType"/>
  <element name="TrafficSpace" substitutionGroup="core:AbstractUnoccupiedSpace" type="anyType"/>
  <element name="TrafficArea" substitutionGroup="core:AbstractThematicSurface" type="anyType"/>
</schema>
